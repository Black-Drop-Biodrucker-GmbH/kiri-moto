{
    "name": "grid-apps",
    "version": "4.7.0",
    "description": "grid.space 3d slicing & modeling tools",
    "author": "Stewart Allen <sa@grid.space>",
    "license": "MIT",
    "private": false,
    "repository": {
        "type": "git",
        "url": "https://github.com/gridspace/apps.git"
    },
    "keywords": [
        "grid.space",
        "mesh:tool",
        "kiri:moto",
        "kirimoto",
        "kiri",
        "mesh",
        "editor",
        "3D",
        "FDM",
        "CAM",
        "CNC",
        "mSLA",
        "laser",
        "waterjet",
        "wire edm",
        "wire-edm",
        "dragknife",
        "drag knife",
        "gcode",
        "slicer"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "dependencies": {
        "earcut": "^3.0.1",
        "jszip": "^3.7.1",
        "three": "^0.182.0"
    },
    "devDependencies": {
        "@yao-pkg/pkg": "^5.12.0",
        "esbuild": "^0.25.5",
        "postject": "^1.0.0-alpha.6"
    },
    "pkg": {
        "assets": ["src/cli/*.json"]
    },
    "bin": {
        "kiri": "src/kiri/run/cli.js"
    },
    "scripts": {
        "slice":          "node src/kiri/run/cli.js",
        "bundle":         "node bin/bundle-cli.mjs",
        "build:win":         "powershell -ExecutionPolicy Bypass -File bin/build-sea-win.ps1",
        "build:linux":       "bash bin/build-sea-linux.sh"
    },
    "sideEffects": true,
    "type": "module"
}
